<?xml version="1.0" encoding="utf-8"?>
<!--
  The scanned certificates hold personal data of their owners, so they stay on
  this device: no cloud backup and no device-to-device transfer. From Android 12
  allowBackup="false" stops only the cloud backup; these rules stop both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
