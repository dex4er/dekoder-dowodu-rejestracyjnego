{
  "private": true,
  "name": "dekoder-dowodu-rejestracyjnego",
  "description": "Dekoder dowodu rejestracyjnego",
  "version": "0.3.0",
  "author": "Piotr Roszatycki",
  "license": "GPL-2.0",
  "homepage": "https://github.com/dex4er/dekoder-dowodu-rejestracyjnego",
  "repository": {
    "type": "git",
    "url": "https://github.com/dex4er/dekoder-dowodu-rejestracyjnego"
  },
  "bugs": {
    "url": "https://github.com/dex4er/dekoder-dowodu-rejestracyjnego/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "pnpm test:unit",
    "test:unit": "ng test --no-watch",
    "type:check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "biome": "pnpm dlx @biomejs/biome@2.6.8",
    "biome:check": "pnpm biome check",
    "biome:fix": "pnpm biome check --fix",
    "biome:migrate": "pnpm biome migrate --write",
    "trunk": "pnpm dlx @trunkio/launcher@1.3.4",
    "trunk:check": "pnpm trunk check",
    "trunk:check:all": "pnpm trunk check --all",
    "trunk:fix": "pnpm trunk check --fix",
    "trunk:fix:all": "pnpm trunk check --fix --all",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm biome:check",
    "lint:fix": "pnpm biome:fix",
    "version": "sh version.sh $npm_package_version"
  },
  "engines": {
    "node": ">= 24.0.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "dependencies": {
    "@angular/common": "~22.2.7",
    "@angular/compiler": "~22.2.7",
    "@angular/core": "~22.2.7",
    "@angular/forms": "~22.2.7",
    "@angular/platform-browser": "~22.2.7",
    "@angular/router": "~22.2.7",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@ionic/angular": "^9.0.13",
    "buffer": "^6.0.3",
    "ionicons": "^8.1.1",
    "polish-vehicle-registration-certificate-decoder": "^1.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "~22.2.8",
    "@angular/cli": "~22.2.8",
    "@angular/compiler-cli": "~22.2.7",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
